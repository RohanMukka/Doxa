DATABASE_URL="file:./dev.db"

# Where the pattern analysis runs. Left unset, a local model is preferred and the
# hosted one is only reachable when you say so for that particular run.
#   local  — require a local model; fail rather than fall back
#   cloud  — prefer Google's, still asks before each run
# DOXA_INFERENCE="local"

# Local inference through Ollama. Nothing leaves this machine on this path.
#   ollama pull llama3.1:8b
# DOXA_LOCAL_MODEL="llama3.1:8b"
# OLLAMA_HOST="http://127.0.0.1:11434"

# Optional, and only used if you explicitly send a run to Google. Setting it
# does not by itself allow anything to be sent.
# Free key from https://aistudio.google.com/apikey — no credit card required.
GEMINI_API_KEY=""

# Optional. Defaults to gemini-3.6-flash. Free-tier availability shifts, so run
# `npm run models` to see what your key can actually reach.
# DOXA_MODEL="gemini-3.6-flash"
