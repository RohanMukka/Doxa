generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Analysis {
  id             String   @id @default(cuid())
  insights       String // JSON array of { headline, evidence, tryInstead }
  entriesAnalyzed Int
  createdAt      DateTime @default(now())
  /// Which backend produced this read, and whether producing it meant sending
  /// the journal off this machine. Recorded per run rather than read from
  /// current config, because config changes and this claim has to stay true
  /// about the insights actually on screen.
  backend        String   @default("gemini")
  model          String   @default("unknown")
  ranLocally     Boolean  @default(false)
}

model Entry {
  id             String   @id @default(cuid())
  decision       String
  reasoning      String
  confidence     Int
  category       String?
  consultedOthers Boolean @default(false)
  createdAt      DateTime @default(now())
  resolutionDate DateTime
  status         String   @default("open") // "open" | "resolved"
  /// Preregistered falsification criterion, frozen at creation: what the person
  /// said, in advance, would count as being wrong. Without this, resolution is
  /// graded against a memory that the outcome has already edited. Nullable only
  /// because entries written before preregistration existed have no answer.
  falsifier      String?
  /// The disconfirming case, written before the entry was accepted: assume this
  /// went wrong, what happened? Only asked above a confidence threshold, and
  /// only on the half of those decisions the gate was assigned to.
  premortem      String?
  /// Whether the premortem gate fired for this decision. Randomised, so the
  /// app can eventually tell whether its own intervention does anything —
  /// a before-and-after comparison would be confounded with everything else
  /// that changed about the person in the meantime.
  premortemAssigned Boolean?
  // When the outcome was actually recorded, as distinct from resolutionDate,
  // which is when you expected to know. Staleness of an analysis is measured
  // against this.
  resolvedAt     DateTime?
  outcome        String? // "correct" | "incorrect"
  resolutionNote String?
  /// What they *thought* they had said, asked at resolution before the stored
  /// confidence is shown. The distance between this and `confidence` is
  /// hindsight bias, measured rather than assumed.
  recalledConfidence Int?
  /// Whether that recall was collected without the stated confidence having
  /// been visible. A recall taken after peeking measures reading, not memory,
  /// so the hindsight statistics only count the blind ones.
  recallBlind    Boolean?
  /// Set the first time the sealed confidence is deliberately revealed while
  /// the decision is still open. Its presence is what makes `recallBlind` false.
  confidenceRevealedAt DateTime?
  /// "self" | "external" — whether the outcome was graded by the person or by
  /// something outside them. Self-graded accuracy is the number most likely to
  /// flatter; keeping them separable is the only way to see the difference.
  adjudication   String?
}

/// Append-only, hash-chained log. This is the journal's source of truth: `Entry`
/// is a projection of these events and can be rebuilt from them at any
/// time. The point is not architectural fashion — the product's whole claim is
/// that you wrote this down *before* you knew the answer, and a mutable row
/// cannot support that claim. Each event's hash covers the previous one, so a
/// silent edit anywhere breaks the chain from that point on.
model Event {
  seq        Int      @id @default(autoincrement())
  type       String
  entryId    String
  /// Canonical JSON. Key order is normalised before hashing so the digest is
  /// reproducible across machines and serialiser versions.
  payload    String
  recordedAt DateTime
  prevHash   String
  hash       String   @unique

  @@index([entryId])
  @@index([recordedAt])
}

/// One tested claim about how this person reasons.
///
/// Stored whatever the verdict, including the ones that failed. A feature whose
/// point is showing which claims survive scrutiny cannot quietly drop the ones
/// that didn't — that would make it the thing it exists to guard against.
model Hypothesis {
  id            String   @id @default(cuid())
  /// Groups a batch, because false-discovery control is a property of the batch
  /// rather than of any single claim in it.
  runId         String
  /// "swept" — enumerated mechanically from the journal's own shape.
  /// "model"  — proposed in words by a language model.
  source        String
  headline      String
  evidence      String?
  tryInstead    String?
  /// The machine-checkable filter, canonical JSON.
  predicate     String
  /// The same filter as a sentence, so a rejected claim can be argued with.
  predicateText String
  /// Calibration gap inside the predicate minus the gap outside, on held-out
  /// decisions only.
  lift          Float
  nInside       Int
  nOutside      Int
  p             Float
  /// Benjamini-Hochberg adjusted across the batch.
  q             Float
  outcome       String // "held" | "failed" | "untestable"
  reason        String?
  trainingN     Int
  holdoutN      Int
  createdAt     DateTime @default(now())

  @@index([runId])
  @@index([createdAt])
}
